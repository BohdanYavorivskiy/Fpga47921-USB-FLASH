// RTL testbench: btn_led boot and button blinks, shortened timing

`timescale 1ns / 1ps

module tb_blink_tb;

  reg clk = 0;
  always #10 clk = ~clk;

  reg rst = 1, btn = 0;
  wire led;

  // shortened timing: tick every 4 clks, debounce 4 ticks, phase 16 ticks
  reg [1:0] tdiv = 0;
  always @(posedge clk) tdiv <= tdiv + 2'd1;
  wire tick = (tdiv == 2'd3);

  btn_led #(.DEB_BITS(2), .DEB_INIT(0), .PH_BITS(4), .PH_INIT(0), .BOOT_BLINKS(5))
    dut (.clk(clk), .rst(rst), .btn(btn), .tick(tick), .led(led));

  integer rises = 0, errors = 0;
  reg led_d = 0;
  always @(posedge clk) begin
    led_d <= led;
    if (led && !led_d) rises <= rises + 1;
  end

  initial begin
    $dumpfile ("tb_blink_tb.vcd");
    $dumpvars (0, tb_blink_tb);

    #100 rst = 0;
    #16000;                      // power-up sequence: 5 blinks (10 phases x 1.28 us)
    if (rises != 5) begin errors = errors + 1; $display("FAIL: expected 5 boot blinks, got %0d", rises); end
    #500;
    if (led) begin errors = errors + 1; $display("FAIL: LED on before press"); end

    // bouncing press
    btn = 1; #40; btn = 0; #60; btn = 1; #40; btn = 0; #40; btn = 1;
    #8000;
    if (rises != 7) begin errors = errors + 1; $display("FAIL: expected 7 total blinks, got %0d", rises); end
    btn = 0;
    #1000;
    if (led) begin errors = errors + 1; $display("FAIL: LED stuck on"); end

    // second press
    btn = 1; #8000; btn = 0; #1000;
    if (rises != 9) begin errors = errors + 1; $display("FAIL: expected 9 total blinks, got %0d", rises); end

    // glitch shorter than debounce must be ignored
    btn = 1; #100; btn = 0; #8000;
    if (rises != 9) begin errors = errors + 1; $display("FAIL: glitch triggered blink (%0d)", rises); end

    if (errors == 0) $display("TB_BLINK: PASS");
    else             $display("TB_BLINK: FAIL, %0d errors", errors);
    $finish;
  end

endmodule
