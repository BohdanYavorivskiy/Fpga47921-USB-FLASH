// Custom testbench

`timescale 1ns / 1ps

module tb_spi_master_tb;

  reg clk = 1'b0;
  always #5 clk = ~clk;

  reg rst = 1'b1;
  reg cs_n_req = 1'b1;
  reg [7:0] clk_divider = 8'd1;
  reg start = 1'b0;
  reg [7:0] tx_data = 8'd0;
  reg miso = 1'b0;
  wire cs_n, sck, mosi, busy, done;
  wire [7:0] rx_data;

  reg [7:0] expected_tx;
  reg [7:0] slave_data;
  integer bit_index = 0;
  integer edge_count = 0;
  integer errors = 0;
  time cs_release_time;
  time cs_assert_time;
  time last_sck_fall_time;
  time last_sck_rise_time;
  time expected_sck_period = 20;
  reg check_mosi = 1'b0;

  spi_master #(
    .CLK_HZ(100_000_000)
  ) dut (
    .clk(clk),
    .rst(rst),
    .cs_n_req(cs_n_req),
    .clk_divider(clk_divider),
    .start(start),
    .tx_data(tx_data),
    .miso(miso),
    .cs_n(cs_n),
    .sck(sck),
    .mosi(mosi),
    .busy(busy),
    .done(done),
    .rx_data(rx_data)
  );

  always @(posedge sck) begin
    if (!cs_n && busy && check_mosi) begin
      if (bit_index == 0) begin
        if (($time - cs_assert_time) < 7) begin
          errors = errors + 1;
          $display("[%0t] FAIL: CS# setup was shorter than 7 ns", $time);
        end
      end else if (($time - last_sck_rise_time) != expected_sck_period) begin
        errors = errors + 1;
        $display("[%0t] FAIL: SCK period was %0t ns, expected %0t ns",
                 $time, ($time-last_sck_rise_time), expected_sck_period);
      end
      if (mosi !== expected_tx[7-bit_index]) begin
        errors = errors + 1;
        $display("[%0t] FAIL: MOSI bit %0d was incorrect", $time, bit_index);
      end
      miso = slave_data[7-bit_index];
      bit_index = bit_index + 1;
      edge_count = edge_count + 1;
      last_sck_rise_time = $time;
    end
  end

  always @(negedge sck) begin
    if (!cs_n && check_mosi && bit_index == 8)
      last_sck_fall_time = $time;
  end

  always @(negedge cs_n) cs_assert_time = $time;

  always @(posedge cs_n) begin
    if (check_mosi && bit_index == 8 &&
        ($time - last_sck_fall_time) < 5) begin
      errors = errors + 1;
      $display("[%0t] FAIL: CS# hold was shorter than 5 ns", $time);
    end
  end

  task check;
    input condition;
    input [8*48:1] message;
    begin
      if (!condition) begin
        errors = errors + 1;
        $display("[%0t] FAIL: %0s", $time, message);
      end
    end
  endtask

  task transfer_byte;
    input [7:0] tx;
    input [7:0] rx;
    begin
      expected_tx = tx;
      slave_data = rx;
      bit_index = 0;
      edge_count = 0;
      check_mosi = 1'b1;
      tx_data = tx;
      @(posedge clk);
      start = 1'b1;
      @(posedge clk);
      start = 1'b0;
      wait(done);
      #1;
      check(rx_data === rx, "received byte mismatch");
      check(edge_count == 8, "expected eight rising SCK edges");
      check(cs_n === 1'b0, "CS# changed during transfer");
      check(sck === 1'b0, "SCK did not return low when idle");
      check_mosi = 1'b0;
    end
  endtask

  initial begin
    $dumpfile ("tb_spi_master_tb.vcd");
    $dumpvars (0, tb_spi_master_tb);

    #30;
    rst = 1'b0;
    #50;
    check(cs_n === 1'b1, "CS# must be high after reset");
    check(sck === 1'b0, "SCK must be low after reset");

    cs_n_req = 1'b0;
    // Start immediately; the master must defer the byte until CS setup is met.
    transfer_byte(8'hA5, 8'h3C);
    transfer_byte(8'h96, 8'hA7);

    // Request release while a byte is active; it must wait for the byte boundary.
    clk_divider = 8'd2;
    expected_sck_period = 40;
    expected_tx = 8'h5A;
    slave_data = 8'h81;
    bit_index = 0;
    edge_count = 0;
    check_mosi = 1'b1;
    tx_data = expected_tx;
    @(posedge clk);
    start = 1'b1;
    @(posedge clk);
    start = 1'b0;
    repeat (2) @(negedge clk);
    cs_n_req = 1'b1;
    check(cs_n === 1'b0, "CS# released before the byte completed");
    wait(done);
    #1;
    check(rx_data === 8'h81, "received byte mismatch after deferred release");
    check(edge_count == 8, "deferred-release transfer was not eight bits");
    wait(cs_n === 1'b1);
    cs_release_time = $time;
    check(sck === 1'b0, "SCK must be low after the final byte");
    check_mosi = 1'b0;

    // A new assertion must respect the 30 ns minimum high interval.
    cs_n_req = 1'b0;
    wait(cs_n === 1'b0);
    check(($time - cs_release_time) >= 30, "CS# high interval was shorter than 30 ns");
    repeat (2) @(negedge clk);
    clk_divider = 8'd1;
    expected_sck_period = 20;
    transfer_byte(8'hC3, 8'h5E);
    cs_n_req = 1'b1;
    wait(cs_n === 1'b1);

    if (errors == 0) $display("TB_SPI_MASTER: PASS");
    else             $display("TB_SPI_MASTER: FAIL, %0d errors", errors);

    $finish;
  end

  initial begin
    #10000;
    $display("TB_SPI_MASTER: TIMEOUT");
    $finish;
  end

endmodule
